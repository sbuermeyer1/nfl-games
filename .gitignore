__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# raw/processed data can be large and regeneratable — keep out of git by default
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

.ipynb_checkpoints/

# Isolated feature workspaces.
.worktrees/
!data/processed/game_features.parquet
!data/processed/tracker_ledger.parquet
!data/processed/schedule_2026.parquet

# Ridge-v2 research track: the manifest is the committed provenance record. Its feature
# parquet is deliberately NOT negated -- it is 7.3 MB against v1's 251 KB and would be
# re-added whole on every rebuild. Regenerate it with scripts/build_v2_dataset.py --write.
!data/processed/ridge_v2_manifest.json

# The four Ridge-v2 research artifacts: the experiment's record, ~106 KB in total.
!data/processed/ridge_v2_outer_predictions.parquet
!data/processed/ridge_v2_evaluation.json
!data/processed/ridge_v2_ablation.parquet
!data/processed/ridge_v2_calibration.json
